# --- Database ---
DATABASE_URL="postgresql://ticketing:ticketing@localhost:5433/ticketing?schema=public"
SHADOW_DATABASE_URL="postgresql://ticketing:ticketing@localhost:5433/ticketing_shadow?schema=public"

# --- Redis (BullMQ background jobs) ---
REDIS_URL="redis://localhost:6379"

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET="replace-me-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# --- App ---
APP_URL="http://localhost:3000"

# --- Resend (outbound + inbound) ---
# Leave empty to run without email: notifications stay in-app and outbound
# mail is logged as SKIPPED.
RESEND_API_KEY=""
# Optional override, e.g. for tests or regions.
RESEND_BASE_URL=""
EMAIL_FROM="Support <support@example.com>"
# Domain that receives ticket mail, e.g. inbound.example.com. Replies go to
# ticket+TK-000123@<domain>. Empty disables Reply-To threading headers.
INBOUND_DOMAIN=""
# Signing secret of the Resend email.received webhook. Empty accepts unsigned
# payloads with a warning (development only).
RESEND_WEBHOOK_SECRET=""
EMAIL_INBOUND_SECRET=""

# --- Attachments ---
MAX_UPLOAD_BYTES="10485760"
