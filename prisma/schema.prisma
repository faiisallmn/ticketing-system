generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  AGENT
  REQUESTER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
  REOPENED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketSource {
  WEB
  EMAIL
  API
}

enum TicketEventType {
  CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  SEVERITY_CHANGED
  ASSIGNED
  UNASSIGNED
  TEAM_CHANGED
  DEPARTMENT_CHANGED
  CATEGORY_CHANGED
  TAGS_CHANGED
  DETAILS_CHANGED
  COMMENT_ADDED
  COMMENT_EDITED
  ATTACHMENT_ADDED
  SLA_BREACHED
  ESCALATED
}

enum AssignmentStrategy {
  ROUND_ROBIN
  CATEGORY
  WORKLOAD
}

enum EscalationTrigger {
  SLA_BREACH_IMMINENT
  SLA_BREACH
  WAITING_TOO_LONG
}

enum EscalationAction {
  RAISE_PRIORITY
  REASSIGN_TEAM
  NOTIFY_MANAGER
}

enum CannedScope {
  GLOBAL
  TEAM
}

enum NotificationType {
  TICKET_ASSIGNED
  TICKET_CREATED
  STATUS_CHANGED
  COMMENT_ADDED
  SLA_WARNING
  SLA_BREACHED
  ESCALATED
  CSAT_REQUEST
}

enum WebhookEventType {
  TICKET_CREATED
  TICKET_UPDATED
  COMMENT_ADDED
  SLA_BREACHED
  ESCALATED
}

enum WebhookFormat {
  JSON
  SLACK
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Department {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams      Team[]
  users      User[]
  tickets    Ticket[]
  categories Category[]

  @@map("departments")
}

model Team {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  departmentId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  users      User[]
  tickets    Ticket[]

  scopeRules        AutoAssignmentRule[] @relation("RuleScopeTeam")
  targetRules       AutoAssignmentRule[] @relation("RuleTargetTeam")
  escalationScopes  EscalationRule[]     @relation("EscalationScopeTeam")
  escalationTargets EscalationRule[]     @relation("EscalationTargetTeam")
  cannedResponses   CannedResponse[]

  @@index([departmentId])
  @@map("teams")
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           Role     @default(REQUESTER)
  jobTitle       String?
  avatarUrl      String?
  isActive       Boolean  @default(true)

  /// Bumped whenever credentials change or an admin revokes sessions.
  sessionVersion Int       @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  departmentId String?
  teamId       String?

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  team       Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull)

  requestedTickets Ticket[]      @relation("TicketRequester")
  assignedTickets  Ticket[]      @relation("TicketAssignee")
  comments         Comment[]
  attachments      Attachment[]  @relation("AttachmentUploader")
  ticketEvents     TicketEvent[] @relation("TicketEventActor")
  notifications    Notification[]

  assignmentTargets AutoAssignmentRule[] @relation("RuleTargetUser")
  createdCanned     CannedResponse[]     @relation("CannedCreatedBy")
  articles          Article[]
  articleFeedback   ArticleFeedback[]
  apiKeys           ApiKey[]
  savedFilters      SavedFilter[]

  @@index([departmentId])
  @@index([teamId])
  @@index([role])
  @@map("users")
}

model Category {
  id           String      @id @default(cuid())
  name         String
  slug         String      @unique
  description  String?
  color        String      @default("#71717a")
  isActive     Boolean     @default(true)
  departmentId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  tickets    Ticket[]

  slaPolicies       SLAPolicy[]
  assignmentRules   AutoAssignmentRule[]
  escalationRules   EscalationRule[]
  cannedResponses   CannedResponse[]
  articles          Article[]

  @@index([departmentId])
  @@map("categories")
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  color     String   @default("#71717a")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets TicketTag[]

  @@map("tags")
}

model TicketTag {
  ticketId String
  tagId    String

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ticketId, tagId])
  @@index([tagId])
  @@map("ticket_tags")
}

model Ticket {
  id              String       @id @default(cuid())
  publicId        String       @unique
  title           String
  description     String       @db.Text
  status          TicketStatus @default(OPEN)
  priority        Priority     @default(MEDIUM)
  severity        Severity     @default(MEDIUM)
  source          TicketSource @default(WEB)
  emailThreadId   String?      @unique
  requesterId     String
  assigneeId      String?
  teamId          String?
  departmentId    String?
  categoryId      String?
  firstRespondedAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  reopenedAt      DateTime?
  dueResponseAt   DateTime?
  dueResolutionAt DateTime?
  /// Set by the sla-check worker the first time each deadline passes.
  responseBreachNotifiedAt   DateTime?
  resolutionBreachNotifiedAt DateTime?
  /// Bumped by every escalation action; also gates repeat firings.
  escalationLevel Int       @default(0)
  lastEscalatedAt DateTime?
  /// Set when the ticket enters WAITING_ON_CUSTOMER, cleared on exit.
  waitingSinceAt  DateTime?
  csatScore       Int?
  csatComment     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  requester   User        @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee    User?       @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  team        Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  department  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags        TicketTag[]
  comments    Comment[]
  attachments Attachment[]
  events      TicketEvent[]
  notifications Notification[]

  @@index([requesterId])
  @@index([assigneeId])
  @@index([teamId])
  @@index([departmentId])
  @@index([categoryId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("tickets")
}

model Comment {
  id         String   @id @default(cuid())
  ticketId   String
  authorId   String
  body       String   @db.Text
  isInternal Boolean  @default(false)
  /// Resend inbound email id — dedupes redelivered webhooks.
  externalId String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id], onDelete: Restrict)
  attachments Attachment[]

  @@index([ticketId, createdAt])
  @@map("comments")
}

model Attachment {
  id          String   @id @default(cuid())
  ticketId    String
  commentId   String?
  uploaderId  String
  filename    String
  storagePath String
  mimeType    String
  size        Int
  createdAt   DateTime @default(now())

  ticket   Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  comment  Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  uploader User     @relation("AttachmentUploader", fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([commentId])
  @@map("attachments")
}

model TicketEvent {
  id        String           @id @default(cuid())
  ticketId  String
  actorId   String?
  type      TicketEventType
  field     String?
  oldValue  String?
  newValue  String?
  metadata  Json?
  createdAt DateTime         @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?  @relation("TicketEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("ticket_events")
}

model BusinessHours {
  id        String   @id @default(cuid())
  name      String
  timezone  String   @default("UTC")
  /// 0 = Sunday … 6 = Saturday.
  workdays  Int[]    @default([1, 2, 3, 4, 5])
  /// "HH:MM" 24-hour local times.
  workStart String   @default("09:00")
  workEnd   String   @default("17:00")
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  policies SLAPolicy[]

  @@map("business_hours")
}

model Holiday {
  id          String   @id @default(cuid())
  name        String
  /// Calendar date; compared in the business calendar's timezone.
  date        DateTime @db.Date
  isRecurring Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("holidays")
}

model SLAPolicy {
  id                   String    @id @default(cuid())
  name                 String
  /// Match scope: null = any.
  categoryId           String?
  priority             Priority?
  firstResponseMinutes Int
  resolutionMinutes    Int
  businessHoursId      String
  isActive             Boolean   @default(false)
  isDefault            Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  category      Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  businessHours BusinessHours @relation(fields: [businessHoursId], references: [id], onDelete: Restrict)

  @@index([categoryId])
  @@map("sla_policies")
}

model AutoAssignmentRule {
  id           String             @id @default(cuid())
  name         String
  strategy     AssignmentStrategy
  /// Scope: only tickets matching these (null = any).
  categoryId   String?
  teamId       String?
  /// Targets.
  targetTeamId String?
  targetUserId String?
  position     Int                @default(0)
  isActive     Boolean            @default(false)
  /// Execution state, e.g. { "lastUserId": "..." } for round-robin.
  state        Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  team       Team?     @relation("RuleScopeTeam", fields: [teamId], references: [id], onDelete: SetNull)
  targetTeam Team?     @relation("RuleTargetTeam", fields: [targetTeamId], references: [id], onDelete: SetNull)
  targetUser User?     @relation("RuleTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@map("auto_assignment_rules")
}

model EscalationRule {
  id               String            @id @default(cuid())
  name             String
  trigger          EscalationTrigger
  thresholdMinutes Int
  /// Scope: only tickets matching these (null = any).
  categoryId       String?
  teamId           String?
  priority         Priority?
  action           EscalationAction
  targetTeamId     String?
  newPriority      Priority?
  cooldownMinutes  Int               @default(60)
  position         Int               @default(0)
  isActive         Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  team       Team?     @relation("EscalationScopeTeam", fields: [teamId], references: [id], onDelete: SetNull)
  targetTeam Team?     @relation("EscalationTargetTeam", fields: [targetTeamId], references: [id], onDelete: SetNull)

  @@map("escalation_rules")
}

model CannedResponse {
  id          String      @id @default(cuid())
  title       String
  body        String      @db.Text
  shortcut    String?
  scope       CannedScope @default(GLOBAL)
  teamId      String?
  categoryId  String?
  createdById String
  usageCount  Int         @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  team      Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy User      @relation("CannedCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([teamId])
  @@map("canned_responses")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  ticketId  String?
  type      NotificationType
  title     String
  body      String?
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([ticketId])
  @@map("notifications")
}

model Webhook {
  id        String            @id @default(cuid())
  name      String
  url       String
  /// HMAC-SHA256 secret sent as X-Webhook-Signature: sha256=<hex>.
  secret    String
  events    WebhookEventType[] @default([])
  format    WebhookFormat     @default(JSON)
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  deliveries WebhookDelivery[]

  @@map("webhooks")
}

model WebhookDelivery {
  id           String                 @id @default(cuid())
  webhookId    String
  event        WebhookEventType
  payload      Json
  status       WebhookDeliveryStatus  @default(PENDING)
  attempts     Int                    @default(0)
  responseCode Int?
  error        String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

model OutboundEmail {
  id         String      @id @default(cuid())
  to         String
  subject    String
  template   String
  html       String      @db.Text
  ticketId   String?
  status     EmailStatus @default(PENDING)
  providerId String?
  error      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([ticketId])
  @@index([status, createdAt])
  @@map("outbound_emails")
}

model Article {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  content     String        @db.Text
  excerpt     String?
  categoryId  String?
  status      ArticleStatus @default(DRAFT)
  views       Int           @default(0)
  helpful     Int           @default(0)
  unhelpful   Int           @default(0)
  authorId    String
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author   User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  feedback ArticleFeedback[]

  @@index([status])
  @@index([categoryId])
  @@map("articles")
}

model ArticleFeedback {
  id        String   @id @default(cuid())
  articleId String
  userId    String?
  isHelpful Boolean
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([articleId, userId])
  @@index([articleId])
  @@map("article_feedback")
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  /// First 8 characters of the key, shown in the admin UI for identification.
  prefix     String
  keyHash    String    @unique
  userId     String
  scopes     String[]  @default([])
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

model SavedFilter {
  id        String   @id @default(cuid())
  userId    String
  name      String
  /// URL query params, e.g. { status: "OPEN", priority: "HIGH" }.
  query     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_filters")
}
